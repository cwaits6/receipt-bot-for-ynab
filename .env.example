# Copy to .env (git-ignored) and fill in. Never commit real values.
ANTHROPIC_API_KEY=
YNAB_ACCESS_TOKEN=
# The bot's own dedicated Signal number, in international format.
SIGNAL_ACCOUNT=+15550100000
# Your time zone, so "today" means your today (YNAB rejects future-dated transactions).
TZ=America/New_York
